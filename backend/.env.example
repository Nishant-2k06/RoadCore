# RoadCore Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://roadcore_user:roadcore_password@localhost:5432/roadcore_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadcore_db
DB_USER=roadcore_user
DB_PASSWORD=roadcore_password

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_roadcore_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_roadcore_2026
JWT_REFRESH_EXPIRES_IN=7d

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=roadcore_admin
MINIO_SECRET_KEY=roadcore_secret_password
MINIO_BUCKET_OBSERVATIONS=roadcore-observations
MINIO_BUCKET_EVIDENCE=roadcore-evidence

# AI / ML Service Bridge (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# Corridor & Tolling Config
BASE_RATE_PER_KM=2.15
MAX_PLAUSIBLE_SPEED_KMH=180
AI_CONFIDENCE_THRESHOLD=0.75
